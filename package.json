{
  "name": "esgrow-studio",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client && node scripts/prerender.mjs",
    "start": "npm start -w server",
    "seed": "npm run seed -w server",
    "test": "node --test server/test/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "db:local": "node scripts/local-db.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10"
  }
}
